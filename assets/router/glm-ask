#!/usr/bin/env python3
"""One-shot query to GLM (Z.ai) over the Anthropic-compatible endpoint.

    glm-ask "question"              question as argument
    glm-ask < brief.md              question on stdin
    glm-ask -f brief.md             question from a file
    glm-ask --thinking "question"   also print the reasoning block

Unlike ~/.local/bin/glm this spawns no Claude Code runtime, so it is safe to
call from inside a running session. No agentic tools: brief in, opinion out.
Credentials come from ~/.zai/env.
"""

from __future__ import annotations

import argparse
import http.client
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

# Windows pipes default to the legacy ANSI codepage: the streamed answer would
# die mid-generation on the first character it cannot encode (emoji, CJK).
if sys.platform == "win32":
    for _stream in (sys.stdin, sys.stdout, sys.stderr):
        if _stream is not None:
            _stream.reconfigure(encoding="utf-8", errors="replace")

ENDPOINT = "https://api.z.ai/api/anthropic/v1/messages"
ENV_FILE = Path.home() / ".zai" / "env"
DEFAULT_MODEL = "glm-5.3-flash"
DEFAULT_MAX_TOKENS = 16000


def read_api_key() -> str:
    """Read ZAI_API_KEY from ~/.zai/env, failing loudly if it is absent."""
    if not ENV_FILE.exists():
        sys.exit(f"glm-ask: missing {ENV_FILE} — put ZAI_API_KEY=... there")
    for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line.startswith("ZAI_API_KEY="):
            key = line.split("=", 1)[1].strip().strip("'\"")
            if key and key != "INCOLLA_QUI_LA_KEY":
                return key
    sys.exit(f"glm-ask: ZAI_API_KEY not set in {ENV_FILE}")


def ask(prompt: str, model: str, max_tokens: int, timeout: int, show_thinking: bool,
        quiet: bool = False) -> dict:
    """Stream the answer, echoing text as it arrives.

    Streaming is not a preference here: a long non-streamed body is delivered as one
    chunked read that Z.ai drops around the six-minute mark (IncompleteRead), losing
    the whole generation. Reading event by event also means a mid-flight failure keeps
    whatever already arrived.
    """
    payload = json.dumps(
        {
            "model": model,
            "max_tokens": max_tokens,
            "stream": True,
            "thinking": {"type": "enabled"},
            "reasoning_effort": "max",
            "output_config": {"effort": "max"},
            "messages": [{"role": "user", "content": prompt}],
        }
    ).encode()
    request = urllib.request.Request(
        ENDPOINT,
        data=payload,
        headers={
            "Authorization": f"Bearer {read_api_key()}",
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
    )

    text_parts: list[str] = []
    thinking_parts: list[str] = []
    usage: dict = {}
    stop_reason = None
    truncated = False

    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            for raw in response:
                line = raw.decode("utf-8", errors="replace").strip()
                if not line.startswith("data:"):
                    continue
                try:
                    event = json.loads(line[5:].strip())
                except json.JSONDecodeError:
                    continue

                kind = event.get("type")
                if kind == "content_block_delta":
                    delta = event.get("delta", {})
                    if delta.get("type") == "text_delta":
                        chunk = delta.get("text", "")
                        text_parts.append(chunk)
                        if not quiet:  # --json mode: stdout must hold only the final object
                            print(chunk, end="", flush=True)
                    elif delta.get("type") == "thinking_delta":
                        chunk = delta.get("thinking", "")
                        thinking_parts.append(chunk)
                        if show_thinking:
                            print(chunk, end="", file=sys.stderr, flush=True)
                elif kind == "message_delta":
                    usage.update(event.get("usage", {}))
                    stop_reason = event.get("delta", {}).get("stop_reason", stop_reason)
                elif kind == "message_start":
                    usage.update(event.get("message", {}).get("usage", {}))
                elif kind == "error":
                    truncated = True
                    print(f"\nglm-ask: server error event: {event.get('error')}", file=sys.stderr)
                    break
    except urllib.error.HTTPError as exc:
        sys.exit(f"glm-ask: HTTP {exc.code} — {exc.read().decode(errors='replace')[:500]}")
    # TimeoutError is a *sibling* of ConnectionError under OSError, not a child:
    # naming ConnectionError alone lets a socket timeout escape as a traceback.
    except (urllib.error.URLError, http.client.IncompleteRead, OSError) as exc:
        truncated = True
        print(f"\nglm-ask: stream interrupted ({exc!r}) — keeping partial output", file=sys.stderr)

    return {
        "model": model,
        "text": "".join(text_parts),
        "thinking": "".join(thinking_parts),
        "usage": usage,
        "stop_reason": "interrupted" if truncated else stop_reason,
    }


def _exit_for_stop(response: dict) -> None:
    """A referto that did not reach end_turn must fail the run.

    The dangerous case is a partial answer that exits 0: the caller sees bytes on
    stdout and treats a beheaded referto as a complete one. Keep the text already
    printed, but exit non-zero so the panel marks it KO.
    """
    stop = response.get("stop_reason")
    usage = response.get("usage", {})
    print(f"[{response.get('model')} · in {usage.get('input_tokens')} · "
          f"out {usage.get('output_tokens')} · stop {stop}]", file=sys.stderr)
    if stop != "end_turn":
        if stop == "max_tokens":
            print("glm-ask: answer truncated — rerun with a larger -t", file=sys.stderr)
        sys.exit(3)


def main() -> None:
    parser = argparse.ArgumentParser(description="Ask GLM one question.")
    parser.add_argument("prompt", nargs="*", help="prompt text (default: stdin)")
    parser.add_argument("-f", "--file", help="read the prompt from a file")
    parser.add_argument("-m", "--model", default=DEFAULT_MODEL)
    parser.add_argument("-t", "--max-tokens", type=int, default=DEFAULT_MAX_TOKENS)
    parser.add_argument("--timeout", type=int, default=600, help="seconds")
    parser.add_argument("--thinking", action="store_true", help="print reasoning too")
    parser.add_argument("--json", action="store_true", help="print the raw response")
    args = parser.parse_args()

    if args.file:
        prompt = Path(args.file).read_text(encoding="utf-8")
    elif args.prompt:
        prompt = " ".join(args.prompt)
    elif not sys.stdin.isatty():
        prompt = sys.stdin.read()
    else:
        parser.error("no prompt given (argument, --file, or stdin)")

    if not prompt.strip():
        parser.error("prompt is empty")

    response = ask(prompt, args.model, args.max_tokens, args.timeout, args.thinking,
                   quiet=args.json)

    if args.json:
        print(json.dumps(response, indent=2, ensure_ascii=False))
        _exit_for_stop(response)
        return

    print()  # the stream leaves the cursor mid-line
    _exit_for_stop(response)


if __name__ == "__main__":
    main()
