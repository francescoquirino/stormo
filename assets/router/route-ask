def _merge(base: dict, override: dict) -> dict:
    """Recursive merge: a partial {"openai": {"reserve": 0.4}} must not wipe
    the sibling keys (a shallow update did, and crashed on the next read)."""
    out = dict(base)
    for k, v in override.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = _merge(out[k], v)
        else:
            out[k] = v
    return out


def load_config() -> dict:
    if not CONFIG.exists():
        ROUTE_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n",
                      encoding="utf-8")
    return _merge(DEFAULT_CONFIG, json.loads(CONFIG.read_text(encoding="utf-8")))


