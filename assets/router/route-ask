def lead_provider() -> str:
    """Which subscription runs THIS orchestrating session (from ANTHROPIC_BASE_URL).

    The `glm` wrapper and `code-glm` point it at z.ai; unset or Anthropic's
    own host means a normal Claude session.
    """
    base_url = os.environ.get("ANTHROPIC_BASE_URL", "")
    if base_url and "api.anthropic.com" not in base_url and "z.ai" in base_url:
        return "zai"
    return "claude"


def anthropic_env() -> dict[str, str]:
    """Environment that reaches the REAL Claude whatever session we run in.

    Inside a `glm` session every ANTHROPIC_* variable points at z.ai, so a bare
    `claude` would loop back to GLM wearing a Claude name. CLAUDE_ROUTE_GUARD
    keeps the child's own hook from spawning a /usage probe (see run_guard).
    """
    env = {k: v for k, v in os.environ.items() if not k.startswith("ANTHROPIC_")}
    env["CLAUDE_ROUTE_GUARD"] = "1"
    return env


def dispatchable(model: str) -> bool:
    """A model -m/--planner/--writer/--reviewer may name: in a tier, not the lead's."""
    spec = MODELS.get(model)
    lead = lead_provider()
    return bool(spec) and not spec.get("design_only") and not (
        spec["account"] == lead and lead != "claude")


