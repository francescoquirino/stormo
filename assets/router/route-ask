def resolve_only_tier(cli_value: str | None) -> str | None:
    """The tier this run is locked to, or None for the normal policy.

    --only-tier wins over the environment. An unrecognised value is an error,
    never a silently lifted lock: a typo must not turn HIGH mode into "use
    anything".
    """
    raw = cli_value if cli_value is not None else os.environ.get(ONLY_TIER_ENV, "")
    value = raw.strip().upper()
    if value in ("", "AUTO"):
        return None
    if value in TIERS:
        return value
    raise ValueError(f"{ONLY_TIER_ENV} / --only-tier must be A, B, C or auto, not '{raw}'")


